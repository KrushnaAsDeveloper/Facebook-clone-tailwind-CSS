<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= user.username %> - Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">

  <!-- Cover Photo -->
  <div class="w-full h-60 bg-gradient-to-r from-blue-500 to-indigo-600 relative">
    <!-- Profile Picture -->
    <div class="absolute -bottom-16 left-8">
      <img src="/uploads/<%= user.profilePic %>" 
           class="w-36 h-36 rounded-full border-4 border-white shadow-lg object-cover" />
      <h1 class="mt-4 text-2xl font-bold text-gray-900"><%= user.username %></h1>
      <p class="text-gray-600"><%= user.bio %></p>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="flex justify-end pr-10 mt-6">
    <button class="bg-blue-600 text-white px-4 py-2 rounded-lg shadow">Add Friend</button>
    <button class="ml-3 bg-gray-200 text-gray-700 px-4 py-2 rounded-lg shadow">Message</button>
  </div>

  <!-- About Section -->
  <div class="max-w-4xl mx-auto mt-20 bg-white p-6 rounded-xl shadow">
    <h2 class="text-xl font-semibold mb-4">About</h2>
    <p class="text-gray-700"><%= user.bio %></p>
  </div>

  <!-- Posts Section -->
  <div class="max-w-4xl mx-auto mt-6 space-y-6">
    <% posts.forEach(post => { %>
      <div class="bg-white p-4 rounded-xl shadow">
        <h3 class="font-bold text-gray-800"><%= user.username %></h3>
        <p class="text-gray-600 mt-2"><%= post.content %></p>
        <div class="flex justify-between mt-4 text-gray-500 text-sm">
          <span>👍 Like</span>
          <span>💬 Comment</span>
          <span>↗️ Share</span>
        </div>
      </div>
    <% }) %>
  </div>

</body>
</html>
